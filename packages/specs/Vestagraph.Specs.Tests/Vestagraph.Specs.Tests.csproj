<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Vestagraph.Specs.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Run the tests with Microsoft.Testing.Platform (decision 0027). -->
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <OutputType>Exe</OutputType>
    <!-- Reqnroll asks for the "en-US" culture by name; globalization-invariant mode (Directory.Build.props) refuses that unless predefined cultures are not required. The data stays invariant: no ICU data is loaded. -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Reqnroll writes each feature's generated test class into obj/, not next to the .feature file in docs/specs/. -->
    <ReqnrollUseIntermediateOutputPathForCodeBehind>true</ReqnrollUseIntermediateOutputPathForCodeBehind>
  </PropertyGroup>
  <ItemGroup>
    <!-- The specifications live in docs/specs/ (decision 0043); they are linked in, not copied. -->
    <ReqnrollFeatureFile Include="..\..\..\docs\specs\**\*.feature" Link="docs-specs\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Reqnroll.NUnit" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>
</Project>
