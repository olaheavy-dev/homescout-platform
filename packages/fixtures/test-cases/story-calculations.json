      "id": "b1-service-charge-difference",
      "description": "B1 service charge: 2026 budget minus listing claim, per year and per month.",
      "rule": {
        "source": "Stage 2 plan section 1 (B1 inputs); rounding per decision 0021",
        "url": "docs/planning/stage-2-plan.md"
      },
      "inputs": {
        "listing_service_charge_annual_pence": 240000,
        "budget_service_charge_annual_pence": 372000
      },
      "steps": [
        {
          "n": 1,
          "description": "Yearly difference = 372000 - 240000",
          "value_pence": 132000,
          "rounding": "none (integers)"
        },
        {
          "n": 2,
          "description": "Listing monthly = 240000 / 12 = 20000 exactly",
          "value_pence": 20000,
          "rounding": "none needed (exact)"
        },
        {
          "n": 3,
          "description": "Budget monthly = 372000 / 12 = 31000 exactly",
          "value_pence": 31000,
          "rounding": "none needed (exact)"
        },
        {
          "n": 4,
          "description": "Monthly difference = 31000 - 20000 (difference of rounded monthly lines); equals 132000 / 12 = 11000 exactly",
          "value_pence": 11000,
          "rounding": "none"
        }
      ],
      "expected": {
        "annual_difference_pence": 132000,
        "monthly_difference_pence": 11000
      }
    },
    {
      "id": "b1-mortgage-repayment",
      "description": "Monthly repayment on a 160,000 pound loan (asking price minus 30,000 pound deposit) at 5.5% over 25 years, standard repayment.",
      "rule": {
        "source": "Standard repayment (annuity) formula M = P r / (1 - (1+r)^-n); algebraically the same as M = P r (1+r)^n / ((1+r)^n - 1) as printed by Chase 'Understanding amortized loans and how to calculate mortgage payments' (r = annual rate / 12, n = number of monthly payments). Rounding per decision 0021.",
        "url": "https://www.chase.com/personal/mortgage/education/financing-a-home/loan-amortization"
      },
      "inputs": {
        "asking_price_pence": 19000000,
        "deposit_pence": 3000000,
        "annual_rate": "0.055",
        "term_years": 25,
        "compounding": "monthly",
        "input_sources": "asking price: listing claim; deposit, rate, term: user-entered (stage 2 plan section 1)"
      },
      "steps": [
        {
          "n": 1,
          "description": "Loan P = price - deposit",
          "value_pence": 16000000,
          "rounding": "none"
        },
        {
          "n": 2,
          "description": "Monthly rate r = 0.055 / 12",
          "value_decimal": "0.004583333333333",
          "rounding": "none (kept at high precision, 60 digits in the check)"
        },
        {
          "n": 3,
          "description": "Number of payments n = 25 x 12",
          "value": 300,
          "rounding": "none"
        },
        {
          "n": 4,
          "description": "(1+r)^n",
          "value_decimal": "3.942671556436251",
          "rounding": "none (high precision)"
        },
        {
          "n": 5,
          "description": "(1+r)^-n = 1 / (1+r)^n",
          "value_decimal": "0.253635126762598",
          "rounding": "none (high precision)"
        },
        {
          "n": 6,
          "description": "Unrounded M = P r / (1 - (1+r)^-n)",
          "value_pence_exact": "98253.998765",
          "rounding": "none (high precision)"
        },
        {
          "n": 7,
          "description": "Round M once to the penny, half away from zero",
          "value_pence": 98254,
          "rounding": "once, half away from zero"
        }
      ],
      "expected": {
        "monthly_repayment_pence": 98254
      }
    },
