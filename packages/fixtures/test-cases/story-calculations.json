    {
      "id": "b1-service-charge-difference",
      "description": "B1 service charge: 2026 budget minus listing claim, per year and per month.",
      "rule": {
        "source": "Stage 2 plan section 1 (B1 inputs); rounding per decision 0021",
        "url": "docs/planning/stage-2-plan.md"
      },
      "inputs": {
        "listingServiceChargeAnnualPence": 240000,
        "listingServiceChargeSource": "listing claim (plan section 1)",
        "budgetServiceChargeAnnualPence": 372000,
        "budgetServiceChargeSource": "managing agent's 2026 budget in the management pack (plan section 1)"
      },
      "steps": [
        {
          "n": 1,
          "description": "Yearly difference = 372000 - 240000",
          "valuePence": 132000,
          "rounding": "none (integers)"
        },
        {
          "n": 2,
          "description": "Listing monthly = 240000 / 12 = 20000 exactly",
          "valuePence": 20000,
          "rounding": "none needed (exact)"
        },
        {
          "n": 3,
          "description": "Budget monthly = 372000 / 12 = 31000 exactly",
          "valuePence": 31000,
          "rounding": "none needed (exact)"
        },
        {
          "n": 4,
          "description": "Monthly difference = 31000 - 20000 = 11000 (equals 132000 / 12 exactly)",
          "valuePence": 11000,
          "rounding": "none"
        }
      ],
      "expected": {
        "annualDifferencePence": 132000,
        "monthlyDifferencePence": 11000
      }
    },
    {
      "id": "b1-mortgage-repayment",
      "description": "Monthly repayment on a 160,000 pound loan (asking price minus 30,000 pound deposit) at 5.5% over 25 years, standard repayment.",
      "rule": {
        "source": "Formula: Kirk, D., Contemporary Mathematics, section 6.8 'The Basics of Loans', OpenStax (Rice University), 2023: pmt = P(r/n)(1+r/n)^(nt) / ((1+r/n)^(nt) - 1), here with n = 12 payments a year; the same as P r / (1 - (1+r)^-N) with r = annual rate / 12 and N = 12 x years (our algebra). Secondary: Chase, 'Understanding amortized loans and how to calculate mortgage payments'. Rounding (nearest penny, half away from zero) is HomeScout decision 0021, not the lender convention of always rounding up.",
        "url": "https://openstax.org/books/contemporary-mathematics/pages/6-8-the-basics-of-loans"
      },
      "inputs": {
        "askingPricePence": 19000000,
        "askingPriceSource": "listing claim (plan section 1)",
        "depositPence": 3000000,
        "depositSource": "user-entered (plan section 1)",
        "annualRate": "0.055",
        "annualRateSource": "user-entered (plan section 1)",
        "termYears": 25,
        "termSource": "user-entered (plan section 1)",
        "compounding": "monthly",
        "purchasePriceRule": "purchase price = asking price (founder, 23 Oct 2026)"
      },
      "steps": [
        {
          "n": 1,
          "description": "Loan P = asking price - deposit",
          "valuePence": 16000000,
          "rounding": "none"
        },
        {
          "n": 2,
          "description": "Monthly rate r = 0.055 / 12",
          "valueDecimal": "0.004583333333333",
          "rounding": "none (full precision; 60 digits in the check)"
        },
        {
          "n": 3,
          "description": "Number of payments N = 25 x 12",
          "value": 300,
          "rounding": "none"
        },
        {
          "n": 4,
          "description": "(1+r)^N",
          "valueDecimal": "3.942671556436251",
          "rounding": "none (full precision)"
        },
        {
          "n": 5,
          "description": "(1+r)^-N",
          "valueDecimal": "0.253635126762598",
          "rounding": "none (full precision)"
        },
        {
          "n": 6,
          "description": "Unrounded M = P r / (1 - (1+r)^-N)",
          "valuePenceExact": "98253.998765",
          "rounding": "none (full precision)"
        },
        {
          "n": 7,
          "description": "Round M once to the penny, half away from zero",
          "valuePence": 98254,
          "rounding": "once, half away from zero"
        }
      ],
      "expected": {
        "monthlyRepaymentPence": 98254
      }
    },
