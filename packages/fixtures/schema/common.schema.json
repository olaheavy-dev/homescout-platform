{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homescout.invalid/schema/common.schema.json",
  "title": "Shared definitions",
  "description": "Building blocks reused by the other schemas. Money is whole pence (integer, at least 1: zero is never a valid money value, because 'missing', 'included' and 'not calculated' have their own statuses, AGENTS.md rule 7).",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*$",
      "description": "Stable upper-case identifier such as B1 or B1-SC-LISTING."
    },
    "fullDate": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
      "description": "Calendar date, YYYY-MM-DD."
    },
    "partialDate": {
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
      "description": "YYYY, YYYY-MM or YYYY-MM-DD, so a source that only states a year is not given an invented month or day."
    },
    "nation": {
      "enum": [
        "England",
        "Wales",
        "Scotland",
        "Northern Ireland"
      ]
    },
    "pence": {
      "type": "integer",
      "minimum": 1,
      "description": "Whole pence. Decimals are rejected; zero is rejected."
    },
    "period": {
      "enum": [
        "once",
        "month",
        "year"
      ],
      "description": "How often the amount is charged, as the source states it. The cost engine does the conversions."
    },
    "origin": {
      "enum": [
        "listing-claim",
        "document",
        "official-dataset",
        "user-entered",
        "synthetic",
        "plan"
      ],
      "description": "'plan' marks a value set by the stage 2 plan itself (for example 'not calculated in this version'), not taken from a data source."
    },
    "documentType": {
      "enum": [
        "listing",
        "management-pack",
        "lease",
        "written-statement-of-terms",
        "revised-written-statement",
        "agent-statement",
        "energy-certificate",
        "council-tax-charges",
        "council-tax-band",
        "user-estimate",
        "user-entry",
        "official-guidance",
        "not-applicable",
        "plan-scope"
      ]
    },
    "source": {
      "type": "object",
      "description": "Where a value came from (decisions 0028, 0030). 'label' is the plain-language wording shown to the user.",
      "required": [
        "origin",
        "label",
        "date",
        "synthetic"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "documentType": {
          "$ref": "#/$defs/documentType"
        },
        "documentId": {
          "$ref": "#/$defs/id"
        },
        "date": {
          "$ref": "#/$defs/partialDate"
        },
        "synthetic": {
          "type": "boolean"
        },
        "citationUrl": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "citedText": {
          "type": "string",
          "minLength": 1
        }
      },
      "dependentRequired": {
        "citedText": [
          "citationUrl"
        ]
      },
      "if": {
        "properties": {
          "origin": {
            "const": "document"
          }
        },
        "required": [
          "origin"
        ]
      },
      "then": {
        "required": [
          "documentType"
        ]
      },
      "additionalProperties": false,
      "allOf": [
        {
          "description": "Data marked 'synthetic' as its origin must also carry synthetic: true.",
          "if": {
            "properties": {
              "origin": {
                "const": "synthetic"
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "properties": {
              "synthetic": {
                "const": true
              }
            }
          }
        }
      ]
    }
  }
}
