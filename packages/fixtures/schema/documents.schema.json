{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homescout.invalid/schema/documents.schema.json",
  "title": "Documents file (data/documents.json)",
  "type": "object",
  "required": ["documents"],
  "properties": {
    "$schema": { "type": "string" },
    "documents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/document" } }
  },
  "additionalProperties": false,
  "$defs": {
    "document": {
      "type": "object",
      "description": "A synthetic document. It points to the evidence items it supports instead of repeating their figures (AGENTS.md rule 2).",
      "required": ["id", "homeId", "type", "title", "storyStep", "source", "summary", "evidenceIds"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "homeId": { "$ref": "common.schema.json#/$defs/id" },
        "type": { "$ref": "common.schema.json#/$defs/documentType" },
        "title": { "type": "string", "minLength": 1 },
        "storyStep": { "type": "integer", "minimum": 1 },
        "source": { "$ref": "common.schema.json#/$defs/source" },
        "summary": { "type": "string", "minLength": 1 },
        "excerpt": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "note"],
            "properties": {
              "url": { "type": "string", "pattern": "^https://\\S+$" },
              "note": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
