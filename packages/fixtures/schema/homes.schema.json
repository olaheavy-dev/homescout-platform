{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homescout.invalid/schema/homes.schema.json",
  "title": "Homes file (data/homes.json)",
  "type": "object",
  "required": [
    "homes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "homes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/home"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "address": {
      "type": "object",
      "required": [
        "line1",
        "town",
        "postcode",
        "nation"
      ],
      "properties": {
        "line1": {
          "type": "string",
          "minLength": 1
        },
        "line2": {
          "type": "string",
          "minLength": 1
        },
        "town": {
          "type": "string",
          "minLength": 1
        },
        "postcode": {
          "type": "string",
          "pattern": "^[A-Z]{1,2}\\d{1,2} \\d[A-Z]{2}$"
        },
        "nation": {
          "$ref": "common.schema.json#/$defs/nation"
        }
      },
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "description": "The dwelling inside a building. When a postcode matches several flats, candidateUnits lists them and selectedUnitId says which one the user chose.",
      "required": [
        "kind",
        "label"
      ],
      "properties": {
        "kind": {
          "enum": [
            "flat",
            "house"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "candidateUnits": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "selectedUnitId": {
          "$ref": "common.schema.json#/$defs/id"
        }
      },
      "dependentRequired": {
        "candidateUnits": [
          "selectedUnitId"
        ],
        "selectedUnitId": [
          "candidateUnits"
        ]
      },
      "additionalProperties": false
    },
    "home": {
      "type": "object",
      "required": [
        "id",
        "label",
        "address",
        "coverage"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "buy",
            "rent"
          ]
        },
        "propertyType": {
          "enum": [
            "flat",
            "terraced-house"
          ]
        },
        "bedrooms": {
          "type": "integer",
          "minimum": 0
        },
        "tenure": {
          "enum": [
            "leasehold",
            "freehold",
            "rented"
          ]
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "coverage": {
          "enum": [
            "covered",
            "not-yet-covered"
          ],
          "description": "England is covered; every other nation shows 'not yet covered' (AGENTS.md rule 6)."
        },
        "buildDescription": {
          "type": "string",
          "minLength": 1
        },
        "photoBrief": {
          "type": "object",
          "required": [
            "text",
            "status"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "not-generated"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "if": {
        "properties": {
          "address": {
            "properties": {
              "nation": {
                "const": "England"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "mode",
          "tenure",
          "propertyType",
          "bedrooms",
          "unit"
        ],
        "properties": {
          "coverage": {
            "const": "covered"
          }
        }
      },
      "else": {
        "properties": {
          "coverage": {
            "const": "not-yet-covered"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
