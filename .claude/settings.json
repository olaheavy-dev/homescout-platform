{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make build)",
      "Bash(make generate)",
      "Bash(make format-check)",
      "Bash(make inspect)",
      "Bash(dotnet tool restore)",
      "Bash(git status)",
      "Bash(gh pr view *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push origin docs/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push -u origin test/*)",
      "Bash(git push origin test/*)",
      "Bash(git push -u origin refactor/*)",
      "Bash(git push origin refactor/*)"
    ],
    "ask": [
      "Bash(dotnet add package *)",
      "Bash(dotnet tool install *)",
      "Bash(dotnet restore *--source*)",
      "Bash(dotnet restore *--configfile*)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(gh api -X PATCH *)",
      "Bash(gh api -X PUT *)",
      "Bash(gh api -X POST *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api --method PATCH *)",
      "Bash(gh api --method PUT *)",
      "Bash(gh api --method POST *)",
      "Bash(gh api --method DELETE *)",
      "Bash(gh repo edit *)"
    ],
    "deny": [
      "Bash(cat *.env*)",
      "Bash(cat *.local/*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./.local/**)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git push * refs/heads/main *)",
      "Bash(git push * refs/heads/main)",
      "Bash(git push * +*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git -C * push *)",
      "Bash(git push --all*)",
      "Bash(git push * --all*)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)"
    ]
  }
}
