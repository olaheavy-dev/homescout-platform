{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make build)",
      "Bash(make generate)",
      "Bash(make format-check)",
      "Bash(make inspect)",
      "Bash(dotnet tool restore)",
      "Bash(git status)",
      "Bash(gh pr view *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(dotnet add package *)",
      "Bash(dotnet tool install *)",
      "Bash(dotnet restore *--source*)",
      "Bash(dotnet restore *--configfile*)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(gh api -X PATCH *)",
      "Bash(gh api -X PUT *)",
      "Bash(gh api -X POST *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api --method PATCH *)",
      "Bash(gh api --method PUT *)",
      "Bash(gh api --method POST *)",
      "Bash(gh api --method DELETE *)",
      "Bash(gh repo edit *)"
    ],
    "deny": [
      "Bash(git push *main*)",
      "Bash(git push *HEAD:main*)",
      "Bash(git push *+*)",
      "Bash(git push *--force*)",
      "Bash(git push *-f*)",
      "Bash(git -C * push *)",
      "Bash(cat *.env*)",
      "Bash(cat *.local/*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./.local/**)"
    ]
  }
}
